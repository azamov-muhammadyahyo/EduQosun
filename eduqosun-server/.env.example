# ——— Telegram ilova kalitlari ———
# 1) https://my.telegram.org saytiga telefon raqamingiz bilan kiring
# 2) "API development tools" → ilova yarating (App title: EduQosun, Platform: Desktop)
# 3) Chiqqan api_id va api_hash qiymatlarini shu yerga yozing
# Bu kalitlarni hech kimga bermang va git'ga yuklamang (.env fayli .gitignore'da).
TG_API_ID=
TG_API_HASH=

# ——— Server ———
# Faqat shu kompyuterdan kirish mumkin bo'lishi uchun 127.0.0.1 qoldiring
HOST=127.0.0.1
PORT=4000

# Bitta faylning eng katta hajmi (MB). Telegram limiti: 2000 MB (Premium bilan 4000 MB)
MAX_UPLOAD_MB=2000

# Telegram sessiyasini shifrlash kaliti. Bo'sh qolsa data/secret.key fayliga avtomatik yaratiladi.
SESSION_SECRET=

# Panel ochiladigan manzillar (vergul bilan)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
