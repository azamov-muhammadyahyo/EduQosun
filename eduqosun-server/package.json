{
  "name": "eduqosun-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EduQosun o'qituvchi paneli uchun Telegram (MTProto) server",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
